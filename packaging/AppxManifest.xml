<?xml version="1.0" encoding="utf-8"?>
<!--
  TRON Direct Enforcement — MSIX packaging (decided route 2026-10-01: local
  install on Long's own computers, self-signed certificate).

  Identity Name "TronDirectEnforcer": local default, reinstallable; rename if
  Long chooses a different stable name.
  Publisher: MUST exactly match the self-signed certificate's Subject
  (e.g. CN=TRON Local). Update both together if the cert changes.

  SignPath Foundation application was rejected 2026-09-16 (visibility grounds);
  that route is parked. If a trusted cert is ever used, set Publisher to the
  cert's full Subject.

  Build provenance: fresh build from pinned commit da94e83b950c via build.ps1
  (offline .NET Framework csc.exe, TronDirectEnforcer.exe, /target:winexe).
  The 2026-09-19 preview ZIP must NOT be used as signing input without provenance
  validation.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 mp rescap">

  <Identity
    Name="TronDirectEnforcer"
    Publisher="CN=TRON Local"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000000" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>TRON Direct Enforcement</DisplayName>
    <PublisherDisplayName>TRON Local</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <!-- Full-trust Win32: firewall COM, ACLs, scheduled tasks, registry. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Elevation: required by the enforcement engine. Self-distribution via
         SignPath does not need Store approval for restricted capabilities,
         but the declaration is still required. -->
    <rescap:Capability Name="allowElevation" />
  </Capabilities>

  <Applications>
    <Application Id="TronDirectEnforcer" Executable="TronDirectEnforcer.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TRON Direct Enforcement"
        Description="TRON Direct Enforcement"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
